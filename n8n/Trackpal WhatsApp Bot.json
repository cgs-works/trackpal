    {
      "parameters": {
        "jsCode": "const payload = $json;\n\nconst normalizePhone = (value) => {\n  let raw = String(value || '').trim();\n  if (raw.includes('@')) raw = raw.split('@')[0];\n  if (raw.includes(':')) raw = raw.split(':')[0];\n  return raw;\n};\n\nconst isLidJid = (value) => String(value || '').includes('@lid');\n\nconst body = payload.body || {};\nconst chatInput = body.chatInput || '';\nconst remoteJid = body.remoteJid || '';\nconst instanceName = body.instanceName || '';\nconst apiKey = body.apiKey || '';\n\n// LID/JID resolution fields from evolution-go\nconst senderPn = body.senderPn || '';\nconst senderLid = body.senderLid || '';\n\nconst data = payload.data || {};\nconst msg = data.message || {};\nconst from = msg.from || msg.key?.remoteJid || '';\n\n// Derive phone from senderPn first (phone JID), never from @lid\nlet phone;\nlet senderLidOut = senderLid;\n\nif (senderPn) {\n  phone = normalizePhone(senderPn);\n} else {\n  const rawJid = remoteJid || from;\n  if (rawJid && isLidJid(rawJid)) {\n    phone = '';\n    senderLidOut = senderLid || rawJid;\n  } else {\n    phone = normalizePhone(rawJid);\n  }\n}\n\nconst message = chatInput || String(msg.body || msg.message?.conversation || '').trim();\nconst instance = instanceName || data.instance || payload.instance || 'default';\n\nreturn [{ json: { phone, message, instance, remoteJid, apiKey, sender_lid: senderLidOut, raw: payload } }];"
      },
