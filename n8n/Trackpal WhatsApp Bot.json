      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.trackpal_backend_url }}/api/v1/integrations/n8n/console",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $('Config').first().json.trackpal_n8n_api_key }}"
