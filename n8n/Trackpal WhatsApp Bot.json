{
  "name": "Trackpal WhatsApp Bot",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "trackpal-whatsapp-bot",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [0, 0],
      "webhookId": "a4adb69b-b32f-4a0c-bae4-de67394ec149"
    },
    {
      "parameters": {
        "jsCode": "const payload = $json;\n\n// Evolution API n8n integration format (n8n/create endpoint)\n// Fields arrive inside payload.body\nconst body = payload.body || {};\nconst chatInput = body.chatInput || '';\nconst remoteJid = body.remoteJid || '';\nconst instanceName = body.instanceName || '';\n\n// Generic webhook format (fallback)\nconst data = payload.data || {};\nconst msg = data.message || {};\nconst from = msg.from || msg.key?.remoteJid || '';\n\nconst phone = remoteJid || String(from).replace('@c.us','').replace('@s.whatsapp.net','');\nconst message = chatInput || String(msg.body || msg.message?.conversation || '').trim();\nconst instance = instanceName || data.instance || payload.instance || 'default';\n\nreturn [{ json: { phone, message, instance, raw: payload } }];"
      },
      "id": "2",
      "name": "Parse input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [224, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=YOUR_TRACKPAL_API_URL/api/v1/integrations/n8n/console",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-API-Key", "value": "YOUR_TRACKPAL_API_KEY" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ phone: $json.phone, message: $json.message, instance: $json.instance }) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "3",
      "name": "Console call",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [448, 0]
    },
    {
      "parameters": {
        "jsCode": "const input = $(\"Parse input\").first().json;\nconst reply = $json.reply || '';\nreturn [{ json: { ...input, reply } }];"
      },
      "id": "4",
      "name": "Merge reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [672, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=YOUR_EVOLUTION_API_URL/message/sendText/{{$json.instance}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "YOUR_EVOLUTION_API_KEY" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: String($json.phone || '').replace('+', ''), text: String($json.reply || '') }) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "5",
      "name": "Evolution API Send",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [896, 0]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [{ "node": "Parse input", "type": "main", "index": 0 }]
      ]
    },
    "Parse input": {
      "main": [
        [{ "node": "Console call", "type": "main", "index": 0 }]
      ]
    },
    "Console call": {
      "main": [
        [{ "node": "Merge reply", "type": "main", "index": 0 }]
      ]
    },
    "Merge reply": {
      "main": [
        [{ "node": "Evolution API Send", "type": "main", "index": 0 }]
      ]
    }
  }
}
