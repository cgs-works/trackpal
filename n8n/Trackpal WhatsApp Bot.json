        "jsCode": "const p = $json; const phone = p.phone; const msg = p.message; const menu = `📋 Master Trackpal\\n1. Crear tenant\\n2. Listar tenants\\n3. Ver tenant\\n4. Editar tenant\\n5. Desactivar tenant\\n6. Reactivar tenant\\n7. Eliminar tenant\\n8. Ayuda`; const help = `📋 AYUDA\\n\\nOpciones:\\n1 - Crear tenant\\n2 - Listar tenants\\n3 - Ver tenant\\n4 - Editar tenant\\n5 - Desactivar tenant\\n6 - Reactivar tenant\\n7 - Eliminar tenant (solo inactivo)\\n8 - Ayuda`; const s = {'2':'list_tenants','3':'awaiting_tenant_id_view','4':'awaiting_tenant_id_edit','5':'awaiting_tenant_id_deactivate','6':'awaiting_tenant_id_reactivate','7':'awaiting_tenant_id_delete'}; const ps = {'awaiting_full_name':'👤 Nombre completo:','awaiting_email':'📧 Email:','awaiting_username':'🔑 Username:','awaiting_password_choice':'🔐 Contraseña?\\n1 - Automatica\\n2 - Manual','awaiting_password_manual':'✏️ Contraseña:','awaiting_tenant_id_view':'🔍 ID del tenant:','awaiting_tenant_id_edit':'✏️ ID del tenant:','awaiting_edit_fields':'✏️ Campos JSON (full_name, email, phone):','awaiting_tenant_id_deactivate':'⛔ ID del tenant:','awaiting_tenant_id_reactivate':'✅ ID del tenant:','awaiting_tenant_id_delete':'🗑️ ID del tenant:'}; const opt = parseInt(msg); if (opt === 8) return [{json:{...p, reply:help, action:null, session:null}}]; if (s[opt]) { const step = s[opt]; return [{json:{...p, reply:ps[step], action:opt===2?'list':'', step:step, session:{phone, step:step, temp_data:'{}'}}}]; } if (opt === 1) { return [{json:{...p, reply:ps.awaiting_full_name, step:'awaiting_full_name', action:null, session:{phone, step:'awaiting_full_name', temp_data:'{}'}}}]; } return [{json:{...p, reply:menu, action:null, session:null}}];"
