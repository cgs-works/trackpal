    {
      "parameters": {
        "mode": "each",
        "jsCode": "const status = $json.status;\nconst resultType = $json.result_type;\nconst resultValue = $json.result_value;\nconst errorCode = $json.error_code;\n\nlet finalMessage;\nconst inputMsg = String($json.message || '');\n\nif (resultType === 'code') {\n  finalMessage = '✅ *Código encontrado*\\n\\n📋 *' + resultValue + '*\\n\\nEste código es válido por tiempo limitado. Úsalo pronto.';\n} else if (resultType === 'url') {\n  finalMessage = '✅ *Enlace encontrado*\\n\\n🔗 ' + resultValue + '\\n\\nAbre el enlace para continuar.';\n} else if (resultType === 'not_found' || resultType === 'duplicate_suppressed') {\n  finalMessage = '❌ *No se encontró código*\\n\\nNo hay correos con códigos de acceso en los últimos 5 minutos.\\n\\nSolicita un nuevo código y espera unos minutos antes de intentar de nuevo.';\n} else if (status === 'failed' || status === 'timeout' || errorCode) {\n  finalMessage = '❌ *Error al buscar código*\\n\\nOcurrió un error al buscar el código. Intenta de nuevo más tarde.';\n} else {\n  finalMessage = '❌ *No se encontró código*\\n\\nIntenta de nuevo más tarde.';\n}\n\nreturn [{ json: { ...$json, reply: finalMessage } }];"
      },
