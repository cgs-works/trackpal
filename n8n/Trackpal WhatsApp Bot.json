        "jsCode": "const data = $json;\nconst msg = String(data.message || '').trim().toLowerCase();\nconst reply = String(data.reply || '').toLowerCase();\n\nconst isLogoutReply = reply.includes('sesión cerrada') || reply.includes('sesion cerrada') || reply.includes('has cerrado sesión') || reply.includes('has cerrado sesion') || reply.includes('goodbye') || reply.includes('cerrado');\nconst isLogout = msg === '0' && isLogoutReply;\n\nif (isLogout) {\n  return [{ json: data }];\n}\nreturn [];"
