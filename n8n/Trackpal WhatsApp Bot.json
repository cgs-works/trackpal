        "jsCode": "const input = $('Parse input').first().json; const reply = (typeof $json.reply === 'string' && $json.reply.trim()) ? $json.reply : 'Servicio temporalmente no disponible. Intenta nuevamente.'; return [{ json: { ...input, reply } }];"
      },
