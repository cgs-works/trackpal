        "mode": "each",
        "jsCode": "const count = parseInt($json._pollAttempts || '0', 10);\nconst maxAttempts = 5;\nconst newCount = count + 1;\n\nif ($json.status === 'completed') {\n  return [{ json: { ...$json, _pollAttempts: newCount, _shouldContinue: false } }];\n}\n\nif (newCount >= maxAttempts) {\n  return [{ json: { ...$json, _pollAttempts: newCount, _shouldContinue: false, status: 'timeout' } }];\n}\n\nreturn [{ json: { ...$json, _pollAttempts: newCount, _shouldContinue: true } }];"
