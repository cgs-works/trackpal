      "typeVersion": 3,
      "position": [
        1200,
        304
      ]
    },
    {
      "parameters": {
        "amount": "={{ $('Config').first().json.message_delay_seconds }}"
      },
      "id": "d6e7f8a9-0b1c-2d3e-4f5a-6b7c8d9e0f1a",
      "name": "Wait",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
