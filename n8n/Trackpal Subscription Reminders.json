      "webhookId": "48dea8c3-2c6c-4b58-a01f-373d4771b0f1"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "{{ $('Config').first().json.evolution_api_url }}/send/text",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $json.evolution_instance_token }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: String($json.recipient_phone || '').replace('+', ''), text: String($json.message || '') }) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "e7f8a9b0-1c2d-3e4f-5a6b-7c8d9e0f1a2b",
      "name": "Evolution API Send",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1680,
        304
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const sendResponse = $input.first()?.json || {};\nconst original = $('SplitInBatches').item.json;\nconst hasError = sendResponse.error !== undefined && sendResponse.error !== null;\nconst statusValue = sendResponse.status ? String(sendResponse.status).toLowerCase() : '';\nconst statusCode = Number(sendResponse.statusCode ?? sendResponse.code ?? 0);\nconst hasKey = Boolean(sendResponse.key || sendResponse.messageId || sendResponse.id || sendResponse?.message?.key?.id);\nconst successStatus = ['success', 'sent', 'pending', 'ok'];\nconst evolutionSuccess = !hasError && (hasKey || successStatus.includes(statusValue) || (Number.isFinite(statusCode) && statusCode >= 200 && statusCode < 300));\nreturn [{ json: { ...original, _evolutionSuccess: evolutionSuccess, _evolutionResponse: sendResponse } }];"
      },
      "id": "f8a9b0c1-2d3e-4f5a-6b7c-8d9e0f1a2b3c",
      "name": "Evaluate Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        304
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "success-check",
              "leftValue": "={{ $json._evolutionSuccess }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a9b0c1d2-3e4f-5a6b-7c8d-9e0f1a2b3c4d",
      "name": "Route by Success?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        2160,
        304
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.trackpal_backend_url }}/api/v1/subscriptions/reminders/{{ $json.id }}/mark-sent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
