          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\\\"number\\\":\\\"{{$json.phone.replace('+', '')}}\\\",\\\"text\\\":\\\"{{$json.reply}}\\\"}",
        "options": {
          "response": {
