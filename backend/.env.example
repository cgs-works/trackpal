# Database - PostgreSQL with asyncpg driver
# Render: postgresql+asyncpg://user:password@host:5432/trackpal?sslmode=require
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/trackpal

# JWT signing key (generate: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=change-me-to-a-secure-random-string

# API key for n8n identify endpoint (header X-API-Key)
N8N_API_KEY=change-me-to-a-secure-api-key

# CORS - comma-separated origins allowed (Cloudflare Pages URL, local dev, etc.)
CORS_ORIGINS=http://localhost:5173,https://trackpal.pages.dev

# Evolution API instance provisioning
EVOLUTION_API_URL=https://rs-evoapi.wilfredocamacho.dev
EVOLUTION_API_KEY=change-me-to-your-evolution-api-key

# JWT TTLs
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis HA session state
# Primary and backup accept redis:// or rediss:// URLs
REDIS_PRIMARY_URL=rediss://default:password@primary-host:6379
REDIS_BACKUP_URL=redis://default:password@backup-host:6379
REDIS_POOL_SIZE=20
REDIS_SOCKET_TIMEOUT_SECONDS=5.0
REDIS_CONNECT_TIMEOUT_SECONDS=5.0
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30.0
REDIS_FAILOVER_FAILURE_THRESHOLD=3
REDIS_BREAKER_OPEN_SECONDS=30
WHATSAPP_SESSION_TTL_MINUTES=15

# Master seed credentials (used by scripts/seed.py)
MASTER_USERNAME=neutrobox
MASTER_PASSWORD=changeme
MASTER_NAME=Master TrackPal
MASTER_PHONE=+1234567890

# Reversible Fernet key for encrypting credentials (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
DATA_ENCRYPTION_KEY=

# Cloudflare R2 for debug uploads (Netflix OTP failures)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=trackpal-debug
R2_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://debug.trackpal.pages.dev

# Cloudflare R2 for Tenant Data Export (dedicated private bucket)
# This is a separate, isolated bucket. NEVER share config with the debug bucket.
# The bucket MUST NOT have a public custom domain.
EXPORT_R2_ACCESS_KEY_ID=
EXPORT_R2_SECRET_ACCESS_KEY=
EXPORT_R2_BUCKET_NAME=trackpal-exports-private
EXPORT_R2_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# Default 900s (15 min) — max lifetime for presigned download URLs
EXPORT_SIGNED_URL_TTL_SECONDS=900

# Mailbox lookup runtime
MAILBOX_LOOKUP_TIMEOUT_SECONDS=20
MAILBOX_LOOKUP_WINDOW_MINUTES=5
MAILBOX_LOOKUP_JOB_TTL_HOURS=72
MAILBOX_DELIVERY_LOG_RETENTION_DAYS=90
