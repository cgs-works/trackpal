# Database - PostgreSQL with asyncpg driver
# Render: postgresql+asyncpg://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/trackpal

# JWT signing key (generate: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=change-me-to-a-secure-random-string

# API key for n8n identify endpoint (header X-API-Key)
N8N_API_KEY=change-me-to-a-secure-api-key

# CORS - comma-separated origins allowed (Cloudflare Pages URL, local dev, etc.)
CORS_ORIGINS=http://localhost:5173,https://trackpal.pages.dev

# Evolution API instance provisioning
EVOLUTION_API_URL=https://rs-evoapi.wilfredocamacho.dev
EVOLUTION_API_KEY=change-me-to-your-evolution-api-key

# JWT TTLs
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Master seed credentials (used by scripts/seed.py)
MASTER_USERNAME=neutrobox
MASTER_PASSWORD=changeme
MASTER_NAME=Master Trackpal
MASTER_PHONE=+1234567890
